    <div style="background:white; padding:30px 50px; border-radius:12px; text-align:center; box-shadow:0 10px 25px rgba(0,0,0,0.2);">
        <div style="font-size:18px; font-weight:bold; color:#2c3e50; margin-bottom:15px;">인쇄 준비 중...</div>
        <div style="font-size:14px; color:#666; margin-bottom:20px;">첨부파일을 인쇄용으로 렌더링하고 있습니다.</div>
        <div class="loader" style="border:5px solid #f3f3f3; border-top:5px solid #3498db; border-radius:50%; width:40px; height:40px; animation:spin 1s linear infinite; margin:0 auto;"></div>
    </div>
  </div>

  <div id="previewModal" class="modal-overlay" style="display:none; z-index: 9999;">
    <div class="modal-content" style="width:95%; max-width:800px; height:80vh; display:flex; flex-direction:column; padding:0;">
      <div class="modal-header" style="padding:15px; border-bottom:1px solid #eee; display:flex; justify-content:space-between; align-items:center;">
        <span id="previewTitle" style="font-weight:bold; font-size:16px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">파일 미리보기</span>
        <button onclick="closePreview()" style="border:none; background:none; font-size:24px; cursor:pointer;">&times;</button>
      </div>
      
      <div class="modal-body" style="flex:1; overflow:auto; padding:0; background:#f0f0f0; position:relative;">
        <div id="previewContainer" style="width:100%; min-height:100%; display:flex; flex-direction:column; align-items:center; padding:10px; box-sizing:border-box; overflow-x:hidden; overflow-y:auto;"></div>
        <div id="previewMsg" style="display:none; position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); color:#666; font-weight:bold;">불러오는 중...</div>
      </div>

      <div class="modal-footer" style="padding:10px; text-align:center; border-top:1px solid #eee;">
        <a id="downloadBtn" href="#" download class="print-btn" style="text-decoration:none; padding:10px 20px; font-size:14px; display:inline-block;">원본 다운로드</a>
        <button onclick="closePreview()" class="temp-btn" style="padding:10px 20px; font-size:14px;">닫기</button>
