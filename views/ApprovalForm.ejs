  <script>
    if (typeof pdfjsLib !== 'undefined') {
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
    }

    async function callApi(url, data) {
        try {
            const token = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
            const res = await fetch(url, { 
                method: 'POST', 
                headers: { 
                    'Content-Type': 'application/json',
                    'CSRF-Token': token 
                }, 
                body: JSON.stringify(data) 
            });
            return await res.json();
        } catch (err) { 
            console.error(err); 
            Swal.fire('통신 오류', '서버와 통신 중 오류가 발생했습니다.', 'error'); 
            throw err; 
        }
    }

    const mode = "<%= mode %>";
    const myName = "<%= user.name %>";
    const myPos = "<%= user.position %>";
    const myPhone = "<%= user.phone %>";
    const myEmail = "<%= user.email %>";
	
	// [추가] 서버에서 전달받은 목록 페이지 상태 변수 저장
    const listPage = "<%= listPage %>";
    const listKeyword = "<%= listKeyword %>";
    const listAuthor = "<%= listAuthor %>";

    let initData = {};
    let existingFiles = [];
    let newFilesQueue = [];

    function formatNum(n) { if(!n) return ""; return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","); }
    function unformatNum(s) { return parseFloat(s.toString().replace(/,/g, '')) || 0; }
    function autoResize(el) { el.style.height = 'auto'; el.style.height = (el.scrollHeight) + 'px'; }

    // ===========================================================================
    // [에디터] CKEditor 5 Classic 관리 헬퍼
    //   - bodyEditor: WRITE 모드에서 마운트된 CKEditor 인스턴스 (없으면 null)
    //   - looksLikeHtml(s): 문자열에 HTML 태그가 포함되어 있는지 빠른 휴리스틱
    //   - escapeHtml(s): plain text를 안전한 HTML로 변환 (XSS 방지)
    //   - renderBodyToView(html, target): VIEW/인쇄용 div에 본문 렌더링.
    //                                     legacy plain text는 escape + \n→<br> 처리.
    //   - initBodyEditor(initialHtml): WRITE 모드에서 에디터 마운트.
    //   - getBodyEditorHTML(): submit 직전에 에디터 HTML 추출.
    //   - getBodyEditorPlainLength(): 검증용 텍스트 길이.
    // ===========================================================================
    let bodyEditor = null;

    function looksLikeHtml(s) {
        return typeof s === 'string' && /<[a-z][\s\S]*?>/i.test(s);
    }
    function escapeHtml(s) {
        if (s == null) return '';
        return String(s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }
    // legacy 호환: 저장된 본문이 plain text(태그 없음)면 안전하게 변환해 보여준다.
    function renderBodyToView(html, target) {
        if (!target) return;
        const value = html || '';
        if (looksLikeHtml(value)) {
            // 서버에서 sanitize 된 HTML이므로 그대로 렌더링 가능
            target.innerHTML = value;
        } else {
            target.innerHTML = escapeHtml(value).replace(/\n/g, '<br>');
        }
        // VIEW/인쇄에서도 표 정렬을 figure 에 강제 매핑
        applyTableAlignment(target);
    }
    // [에디터] toolbar sticky 는 CKEditor 5 자체 동작(ck-sticky-panel) 에 맡긴다.
    //   이전에 직접 JS 로 position:fixed 처리하는 setupBodyToolbarStick 함수를 만들었으나
    //   CKEditor 자체 sticky 와 충돌해 toolbar 위에 빈 공간이 생기는 사례가 확인되어 제거.

    // [표 정렬 후처리] CKEditor 5 는 가운데 정렬을 안쪽 <table style="margin-left:auto;margin-right:auto">
    //   로, 우측 정렬을 <figure style="float:right"> 로 표현한다. 외부 figure 의 마진 CSS 가
    //   table 의 inline 정렬보다 우선되어 가운데 정렬이 적용되지 않는 문제가 있어,
    //   figure / table 양쪽의 style 을 읽어 figure 에 정렬을 일관되게 다시 적용한다.
    //   editable(작성 화면) 과 VIEW div 모두에서 호출한다.
    function applyTableAlignment(root) {
        if (!root || !root.querySelectorAll) return;
        root.querySelectorAll('figure.table').forEach(fig => {
            const table = fig.querySelector(':scope > table');
            const figStyle   = fig.getAttribute('style')   || '';
            const tableStyle = (table && table.getAttribute('style')) || '';
            const combined   = figStyle + ' ; ' + tableStyle;

            const isCenter =
                /margin\s*:\s*0?\s*auto\b/i.test(combined) ||
                /margin\s*:\s*auto\b/i.test(combined) ||
                (/margin-left\s*:\s*auto/i.test(combined) &&
                 /margin-right\s*:\s*auto/i.test(combined));
            const isRight = !isCenter && /float\s*:\s*right/i.test(combined);
            // isLeft 는 기본값(아래)에서 처리

            // figure 에 정렬 강제 적용 (float 차단 + margin 으로 표현)
            fig.style.setProperty('float', 'none', 'important');
            fig.style.setProperty('clear', 'both', 'important');
            // ql-indent-N / ck-indent / margin-left:Npx 같은 CKEditor IndentBlock 흔적이
            // 있으면 그 들여쓰기 양을 보존, 없으면 좌측 정렬 시 기본 1em 들여쓰기를 부여.
            const indentMatch = combined.match(/margin-left\s*:\s*([\d.]+)(?:px|em|rem|pt)/i);
            const userIndent  = indentMatch && indentMatch[1] !== '0'
                ? indentMatch[0].split(':')[1].trim()  // 사용자 지정 값 그대로
                : null;
            const defaultLeftIndent = '1em';   // 좌측 정렬 시 기본 들여쓰기

            if (isCenter) {
                fig.style.setProperty('margin-left',  'auto', 'important');
                fig.style.setProperty('margin-right', 'auto', 'important');
            } else if (isRight) {
                fig.style.setProperty('margin-left',  'auto', 'important');
                fig.style.setProperty('margin-right', '0',    'important');
            } else {
                // 좌측 정렬(기본) — 가벼운 들여쓰기 적용. 사용자가 IndentBlock 으로 더 늘릴 수도 있음.
                fig.style.setProperty('margin-left',  userIndent || defaultLeftIndent, 'important');
                fig.style.setProperty('margin-right', 'auto', 'important');
            }
        });
    }

    function initBodyEditor(initialHtml) {
        const el = document.getElementById('bodyContentEditor');
        if (!el) {
            console.error('[Editor] #bodyContentEditor 요소를 찾을 수 없습니다.');
            return;
        }
        // CKEditor 5 의 ClassicEditor 클래스 위치 — Classic build / Super-build 둘 다 대응.
        //   Classic build : window.ClassicEditor
        //   Super-build   : window.CKEDITOR.ClassicEditor
        const Editor = window.ClassicEditor ||
                       (window.CKEDITOR && window.CKEDITOR.ClassicEditor) ||
                       null;
        if (!Editor) {
            console.error('[Editor] CKEditor 5 라이브러리가 로드되지 않았습니다. ' +
                '/vendor/ckeditor/ckeditor.js 응답을 확인하세요. ' +
                '(super-build 인 경우 window.CKEDITOR.ClassicEditor 가 있어야 합니다)');
            el.innerHTML = '<div style="padding:20px;border:1px dashed #e74c3c;color:#c0392b;font-size:13px;border-radius:6px;">' +
                '본문 에디터를 불러올 수 없습니다. 페이지를 새로고침하거나 관리자에게 문의하세요.<br>' +
                '<small>(브라우저 콘솔 [Editor] 로그를 확인하세요)</small></div>';
            return;
        }

        // CKEditor 5 super-build toolbar 구성.
        //   - 본문 내 이미지 삽입·미디어(mediaEmbed)는 정책상 비활성 (첨부파일 기능 사용)
        //   - 표 안에 커서를 두면 contextual table toolbar 가 자동으로 떠서
        //     행·열 추가·삭제, 셀 병합·해제, 표/셀 속성 변경이 모두 가능.
        //
        // [화이트리스트 방식] super-build 에는 협업·외부서비스·프리미엄 등 수많은 플러그인이
        //   이미 컴파일되어 있고, 그 중 다수는 자동 초기화 단계에서 channelId / license key /
        //   외부 서버 호출을 요구해 init 자체를 실패시킨다. removePlugins 로 하나씩 빼는 대신
        //   "우리가 사용할 plugin 만 plugins 옵션에 명시" 해 그 외 모든 plugin 을 자동 비활성.
        const WANTED_PLUGINS = new Set([
            // 코어
            'Essentials', 'Paragraph', 'Heading',
            // 텍스트 서식
            'Bold', 'Italic', 'Underline', 'Strikethrough',
            'FontColor', 'FontBackgroundColor',
            // 정렬·들여쓰기
            'Alignment', 'Indent', 'IndentBlock',
            // 리스트
            'List', 'ListProperties', 'TodoList',
            // 블록 요소
            'BlockQuote', 'Code', 'CodeBlock', 'HorizontalLine',
            // 링크
            'Link', 'AutoLink',
            // 표 (셀 병합 포함)
            'Table', 'TableToolbar',
            'TableProperties', 'TableCellProperties',
            'TableCaption', 'TableColumnResize', 'TableSelection',
            // 편집 보조
            'RemoveFormat', 'FindAndReplace',
            'PasteFromOffice', 'TextTransformation',
            // 클립보드 (Essentials 의존성이지만 일부 빌드에서 별도)
            'Clipboard'
        ]);
        const builtinPlugins = Editor.builtinPlugins || [];
        const plugins = builtinPlugins.filter(P => P && WANTED_PLUGINS.has(P.pluginName));
        if (!plugins.length) {
            console.warn('[Editor] builtinPlugins 가 비어있어 화이트리스트 적용 실패. 빌드 종류 확인 필요.');
        }

        Editor.create(el, {
            licenseKey: 'GPL',
            language: 'ko',
            placeholder: '내용을 입력하세요.',
            plugins: plugins.length ? plugins : undefined,
            toolbar: {
                items: [
                    'heading', '|',
                    'bold', 'italic', 'underline', 'strikethrough', '|',
                    'fontColor', 'fontBackgroundColor', '|',
                    'bulletedList', 'numberedList', 'todoList', '|',
                    'outdent', 'indent', '|',
                    'alignment', '|',
                    'blockQuote', 'code', 'codeBlock', 'link', 'horizontalLine', '|',
                    'insertTable', '|',
                    'undo', 'redo', '|',
                    'removeFormat', 'findAndReplace'
                ],
                shouldNotGroupWhenFull: true
            },
            // 표 안에서 자동으로 표시되는 contextual toolbar (행·열·셀 병합 등)
            table: {
                contentToolbar: [
                    'tableColumn',
                    'tableRow',
                    'mergeTableCells',
                    'tableProperties',
                    'tableCellProperties'
                ]
            }
        }).then(editor => {
            bodyEditor = editor;
            // legacy plain text 호환: HTML 이 아니면 escape 후 \n→<br>
            if (initialHtml) {
                if (looksLikeHtml(initialHtml)) {
                    editor.setData(initialHtml);
                } else {
                    editor.setData(escapeHtml(initialHtml).replace(/\n/g, '<br>'));
                }
            }
            // 본문 변경 시 숨겨진 textarea 동기화 (기존 검증 로직 호환)
            //                + 표 정렬 후처리 (CKEditor 의 inline 정렬을 figure 에 강제 매핑)
            editor.model.document.on('change:data', () => {
                const ta = document.getElementById('bodyContent');
                if (ta) ta.value = editor.getData();
                applyTableAlignment(editor.ui.view.editable.element);
            });
            // 초기 마운트 직후에도 한 번 실행 (기존 문서를 열었을 때)
            setTimeout(() => applyTableAlignment(editor.ui.view.editable.element), 0);

            // [본문 입력란 높이 강제] CSS 셀렉터(자식 결합자)는 ClassicEditor 마운트 후의
            //   editable 클래스 구조와 어긋나 minHeight 가 적용되지 않는 환경이 있어
            //   editable element 에 inline style 로 직접 적용한다.
            //
            //   추가: CKEditor 가 포커스/blur 시점에 자체 inline style 을 재할당하면서
            //   우리 min-height 가 사라지는 사례가 확인됐다.
            //   MutationObserver 로 editable 의 style 변경을 감시해 즉시 복원한다.
            try {
                const editable = editor.ui.view.editable.element;
                const targetMinHeight = (window.docType === 'G') ? '600px' : '400px';

                const enforceMinHeight = () => {
                    if (editable.style.minHeight !== targetMinHeight ||
                        editable.style.getPropertyPriority('min-height') !== 'important') {
                        editable.style.setProperty('min-height', targetMinHeight, 'important');
                    }
                };
                enforceMinHeight();   // 초기 1회

                // CKEditor 가 style 속성을 갈아치워도 즉시 복원
                const styleObserver = new MutationObserver(enforceMinHeight);
                styleObserver.observe(editable, {
                    attributes: true,
                    attributeFilter: ['style']
                });

                // 포커스/blur 시점에도 명시적 적용 (MutationObserver 가 놓치는 케이스 대비)
                if (editor.editing && editor.editing.view && editor.editing.view.document) {
                    editor.editing.view.document.on('change:isFocused', enforceMinHeight);
                }
            } catch (e) {
                console.warn('[Editor] min-height 적용 실패:', e);
            }
            // toolbar sticky 는 CKEditor 자체 ck-sticky-panel 이 자동 처리한다.
            // 별도 JS 호출 불필요.
        }).catch(err => {
            console.error('[Editor] CKEditor 초기화 실패:', err);
            el.innerHTML = '<div style="padding:20px;border:1px dashed #e74c3c;color:#c0392b;font-size:13px;border-radius:6px;">' +
                '본문 에디터 초기화 중 오류가 발생했습니다.<br><small>' + escapeHtml(err.message || err) + '</small></div>';
        });
    }
    function getBodyEditorHTML() {
        if (bodyEditor) {
            const html = bodyEditor.getData();   // CKEditor 5: 빈 에디터는 '' 반환
            return html || '';
        }
        const ta = document.getElementById('bodyContent');
        return ta ? ta.value : '';
    }
    // 빈 본문(태그만 있고 텍스트 없는 경우)을 차단하기 위한 텍스트 길이
    function getBodyEditorPlainLength() {
        if (!bodyEditor) {
            const ta = document.getElementById('bodyContent');
            return ta ? ta.value.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim().length : 0;
        }
        // CKEditor 5 는 getData()가 빈 본문일 때 ''를 반환하므로 그대로 활용 가능.
        // 안전을 위해 태그/공백 제거 후 길이 측정.
        const html = bodyEditor.getData() || '';
        return html.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim().length;
    }
    // [WAF] 본문 HTML 을 UTF-8 안전 base64 로 인코딩.
    //   btoa 는 Latin1 만 처리하므로 encodeURIComponent+unescape 로 UTF-8 바이트열로 변환 후 인코딩.
    //   (한국어 등 비-Latin1 문자 포함 시 btoa 단독 호출은 예외를 던진다.)
    //   빈 본문('')은 ''로 인코딩되어 서버 디코딩 후에도 ''→빈본문 검증이 정상 동작한다.
    function encodeBodyContentToBase64(html) {
        try {
            return btoa(unescape(encodeURIComponent(html || '')));
        } catch (e) {
            console.error('[BodyContent Encode] 인코딩 실패:', e);
            return '';
        }
    }

    try { initData = JSON.parse(document.getElementById('initData').textContent); } catch(e) {}

    window.onload = function() {
      try {
        if (initData.attachmentIds) existingFiles = initData.attachmentIds.split(',').map(s=>s.trim()).filter(s=>s);
        
        if (initData.docNum) {
			// [개선] 작성 중이거나 결재 대기 중인 문서(수정/결재 가능 상태)일 때만 Lock 실행
			//   '결재완료'(일반 기안 종결 상태)도 더 이상 수정·결재 불가능한 읽기 전용이므로
			//   락을 잡지 않는다. 서버의 CLOSED_STATUSES / lock 정책과 일관성 유지.
			const isMutableStatus = !['최종결재', '지급완료', '결재완료'].includes(initData.status);
    
			if (isMutableStatus) {
				const acquireLock = () => {
					callApi('/api/lock/acquire', { docNum: initData.docNum }).then(res => {
						if (res.status === 'Locked' || res.status === 'Recalled') {
							Swal.fire({
								icon: 'warning',
								title: '접근 불가',
								text: res.msg,
								confirmButtonText: '목록으로',
								allowOutsideClick: false,
								allowEscapeKey: false
							}).then(() => {
								window.location.href = '/list';
							});
						} 
					}).catch(e => console.error("Lock heartbeat fail", e));
				};
				acquireLock();
				const lockInterval = setInterval(acquireLock, 60000);

				// 페이지 종료 시 Lock 해제 이벤트 등록
				window.addEventListener('pagehide', () => {
					clearInterval(lockInterval);
					releaseLock();
				});
			}
        }

        const releaseLock = () => {
            if (initData.docNum) {
                const url = '/api/lock/release';
                const data = JSON.stringify({ docNum: initData.docNum });
                const token = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
                
                fetch(url, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'CSRF-Token': token
                    },
                    body: data,
                    keepalive: true 
                }).catch(err => console.error("Lock release fail:", err));
            }
        };

        window.addEventListener('pagehide', releaseLock);
        window.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'hidden') releaseLock();
        });

        if (mode === "WRITE") {
          if (initData.docNum && initData.status) {
            window.initViewMode(initData);
            enableEditMode();
          } else {
            window.addRow();
            document.getElementById('u-info-line').innerText = `${myPos} : ${myName} (${myPhone})`;
            document.getElementById('u-pos-sign').innerText = myPos;
            enableEditMode();
            // [에디터] 신규 작성: 빈 에디터 마운트
            initBodyEditor('');
          }
          setTimeout(() => document.getElementById('subject').focus(), 600);
        } else if (mode === "VIEW") {
          // [에디터] VIEW 모드: 본문 영역을 읽기 전용 HTML 뷰로 전환
          document.body.classList.add('view-mode');
          window.initViewMode(initData);
          renderViewButtons();
        }
      } catch (err) { console.error(err); }
      finally { setTimeout(() => { document.getElementById('splash-screen').style.display='none'; }, 500); }
    };

    function enableEditMode() {
        document.querySelectorAll('input:not(#docNum):not(#execDate):not(#reqDate):not(#payDate), textarea').forEach(e => e.disabled = false);
        document.getElementById('add-btn-area').style.display = 'block';
        document.getElementById('new-file-area').style.display = 'block';
        document.querySelectorAll('.file-del-btn').forEach(btn => btn.style.display = 'inline-block');
        document.querySelectorAll('.del-btn').forEach(btn => btn.style.display = 'inline-block');
        const guide = document.getElementById('att-guide-text'); if(guide) guide.style.display = 'inline';
        document.getElementById('sig-applicant').innerHTML = ''; 
        document.getElementById('sig-secretary').innerHTML = '';
        document.getElementById('sig-president').innerHTML = '';
        document.getElementById('form-buttons').innerHTML = `<button class="temp-btn" onclick="submitForm('작성중')">임시저장</button><button class="submit-btn" onclick="submitForm('제출완료')">제출(신청)</button><button class="list-btn" onclick="goList()">목록</button>`;
    }

    function renderViewButtons() {
        let html = "";
        let canSign = false;
        if (myPos === "사무총장" && initData.status === "제출완료") canSign = true;
        if (myPos === "총동문회장" && initData.status === "결재중") canSign = true;
        if (myPos === "재무국장" && initData.status === "최종결재") canSign = true;
        
        const isMyDoc = (initData.applicantEmail === myEmail);
        const recallableStatus = ['제출완료', '결재중'].includes(initData.status);

        if (isMyDoc && recallableStatus) html += `<button class="temp-btn" style="background:#d35400;" onclick="recallDoc()">문서 회수 (수정)</button> `;
        // [B-5b] 종결 상태(E='지급완료' / G='결재완료') 모두 인쇄/PDF 저장 가능
        if (initData.status === "지급완료" || initData.status === "결재완료") html += `<button class="print-btn" onclick="printDoc()">인쇄 / PDF 저장</button> `;
        if (canSign) {
            html += `<button class="approve-btn" onclick="processApprove('APPROVE')">${myPos === '재무국장' ? '지급 완료(승인)' : '승인(결재)'}</button>`;
            if (myPos !== '재무국장') html += ` <button class="reject-btn" onclick="processApprove('REJECT')">반려</button>`;
        }
        html += ` <button class="list-btn" onclick="unlockAndGoList()">목록</button>`;
        document.getElementById('form-buttons').innerHTML = html;
    }

    window.submitForm = function(status) {
        const subj = document.getElementById('subject');
        // [에디터] 본문은 CKEditor에서 HTML로 추출.
        const bodyHtml = getBodyEditorHTML();
        const bodyTextLen = getBodyEditorPlainLength();
        const bodyC = document.getElementById('bodyContent');
        if (bodyC) bodyC.value = bodyHtml;
        // [WAF] 본문 HTML(<table>, style=, <figure> 등)이 요청 본문에 그대로 실리면
        //   앞단 WAF(open-appsec)가 XSS/SQLi/RCE/Path-Traversal 시그니처로 오탐한다.
        //   본문만 UTF-8 안전 base64 로 인코딩해 전송 → 요청에서 마크업이 사라져 오탐 제거.
        //   서버는 디코딩 후 동일하게 sanitize 하므로 보안은 동등하다.
        const bodyContentB64 = encodeBodyContentToBase64(bodyHtml);

        // 제출(신청)일 때만 필수 입력 검증, 임시저장은 빈 값 허용
        if (status === '제출완료') {
          if (!subj.value.trim()) return Swal.fire({ icon: 'warning', title: '입력 누락', text: '제목을 입력해주세요.' }).then(() => { setTimeout(() => subj.focus(), 300); });
          if (bodyTextLen === 0) return Swal.fire({ icon: 'warning', title: '입력 누락', text: '내용을 입력해주세요.' }).then(() => { if (bodyEditor) bodyEditor.focus(); });
        }

        const rows = document.getElementsByClassName('item-row');
        const items = []; let total = 0;
        for(let i=0; i<rows.length; i++) { 
            const r = rows[i];
            const nameEl = r.querySelector('.p-name');
            const name = nameEl.value.trim(); 
            if(!name) continue;
            const unitVal = unformatNum(r.querySelector('.p-unit').value);
            const qtyVal = unformatNum(r.querySelector('.p-qty').value);
            const totalVal = unformatNum(r.querySelector('.p-total').value);
            items.push({ name:name, unit: unitVal, qty: qtyVal, total: totalVal, biz:r.querySelector('.p-biz').value, method:r.querySelector('.p-method').value }); 
            total += totalVal;
        }

        // [B-5b] 지출결의서('E')만 첨부파일 필수. 일반 기안('G')은 선택.
        if(window.docType !== 'G' && status === '제출완료' && newFilesQueue.length === 0 && existingFiles.length === 0) {
            return Swal.fire({ icon: 'warning', title: '증빙 누락', text: '증빙 서류(영수증 등)를 첨부해 주세요.' }).then(() => { 
                const fileInput = document.getElementById('attachment');
                setTimeout(() => { fileInput.focus(); fileInput.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 300); 
            });
        }

        Swal.fire({ title: '처리 중...', html: '파일 업로드 및 저장 중입니다.', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
        
        let dNum = document.getElementById('trackingDocNum').value || document.getElementById('docNum').value;
        if(!dNum || dNum === "(자동 생성)") dNum = "";

        const formData = new FormData();
        formData.append('docNum', dNum);
        formData.append('docType', window.docType || 'E');   /* [B-5b] G 모드 식별용 */
        formData.append('subject', subj.value);
        // [WAF] 본문은 base64 인코딩하여 전송. 서버가 bodyContentEnc 플래그를 보고 디코딩한다.
        formData.append('bodyContentEnc', 'base64');
        formData.append('bodyContent', bodyContentB64);
        formData.append('totalAmount', total);
        // executionDate는 총동문회장 결재 시 서버에서 자동 기록 — 클라이언트에서 전송하지 않음
        formData.append('reqDate', initData.reqDate || '');
        formData.append('payDate', initData.payDate || '');
        // presidentSignedDate, presDate는 executionDate로 통합됨 — 전송 불필요
        formData.append('status', status);
        formData.append('existingFileIds', existingFiles.join(","));
        formData.append('items', JSON.stringify(items));

        newFilesQueue.forEach(file => { formData.append('newAttachments', file); });
        
        const token = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

        fetch('/api/submit', {
            method: 'POST',
            headers: { 'CSRF-Token': token },
            body: formData 
        })
        .then(res => res.json())
        .then(res => {
            if (res.status === 'Error') Swal.fire('오류', res.msg, 'error');
            else Swal.fire('완료', res.msg, 'success').then(() => window.goList());
        })
        .catch(err => {
            console.error(err); 
            Swal.fire('통신 오류', '서버와 통신 중 오류가 발생했습니다.', 'error');
        });
    };
    
    // [수정] 행 추가 시 3열 배치 구조 및 Placeholder 적용
    window.addRow = function() { 
        const b = document.getElementById('itemBody'); 
        const r = b.insertRow(-1); 
        r.className = 'item-row'; 
        
        r.innerHTML = `
            <td class="serial-cell txt-center">${b.rows.length} <button class="del-btn" onclick="window.delRow(this)">X</button></td>
            <td><textarea class="p-name txt-center" rows="1"></textarea></td>
            <td><input type="text" class="p-unit txt-right" oninput="window.handleNumInput(this)"></td>
            <td><input type="text" class="p-qty txt-right" oninput="window.handleNumInput(this)"></td>
            <td><input type="text" class="p-total txt-right" readonly placeholder="자동계산"></td>
            <td><textarea class="p-biz txt-center" rows="1" placeholder="상호명, 이름"></textarea></td>
            <td><textarea class="p-method txt-center" rows="1" placeholder="카드, 현금 등"></textarea></td>
        `; 
    };
    
    window.delRow = function(btn) { const b=document.getElementById('itemBody'); if(b.rows.length<=1) return; btn.closest('tr').remove(); for(let i=0;i<b.rows.length;i++) b.rows[i].cells[0].innerHTML = `${i+1} <button class="del-btn" onclick="window.delRow(this)">X</button>`; window.updateGrandTotal(); };
    
    window.processApprove = function(action) { 
        let msg = "승인하시겠습니까?"; if(action === 'REJECT') msg = "반려하시겠습니까?";
        Swal.fire({ title: '확인', text: msg, icon: 'question', showCancelButton: true }).then(r => { 
            if(r.isConfirmed) {
                Swal.fire({ title: '결재 처리 중...', html: '잠시만 기다려주세요.', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
                const realDocNum = document.getElementById('trackingDocNum').value;
                callApi('/api/approve', { docNum: realDocNum, action: action }).then(res => {
                    const icon = res.msg.includes("오류") || res.msg.includes("없습니다") ? 'error' : 'success';
                    Swal.fire('알림', res.msg, icon).then(() => window.goList());
                });
            }
        }); 
    };
    
    // [수정] 목록 버튼 클릭 시 원래 페이지로 이동
    window.goList = function() { 
        // 기존: window.location.href = '/list';
        window.location.href = `/list?page=${listPage}&keyword=${encodeURIComponent(listKeyword)}&author=${encodeURIComponent(listAuthor)}`;
    };
    
    window.recallDoc = function() {
        Swal.fire({ title: '문서를 회수하시겠습니까?', text: "결재 진행 상황이 '작성중' 상태로 변경됩니다.", icon: 'warning', showCancelButton: true, confirmButtonColor: '#d35400', confirmButtonText: '회수 및 수정', cancelButtonText: '취소' }).then((result) => {
            if (result.isConfirmed) {
                callApi('/api/recall', { docNum: document.getElementById('trackingDocNum').value }).then(res => {
                    if(res.status === 'Success') Swal.fire('회수 완료', res.msg, 'success').then(() => window.location.reload());
                    else Swal.fire('오류', res.msg, 'error');
                });
            }
        });
    };
    
    // [수정] 잠금 해제 후 목록 이동 시에도 동일하게 적용
    window.unlockAndGoList = function() { 
        // 기존: window.location.href = '/list';
        window.location.href = `/list?page=${listPage}&keyword=${encodeURIComponent(listKeyword)}&author=${encodeURIComponent(listAuthor)}`;
    };
    
    // [수정] 파일 선택 시 용량(10MB) 및 형식 체크 로직 강화
    window.handleFileSelect = function(input) { 
        if (input.files && input.files.length > 0) { 
            const MAX_FILE_SIZE = 25 * 1024 * 1024; // 25MB (서버 limits와 동일)
            const MAX_FILE_MB   = 25;
            let hasTypeError = false;
            let hasSizeError = false;

            Array.from(input.files).forEach(file => {
                // 1. 용량 체크
                if (file.size > MAX_FILE_SIZE) {
                    hasSizeError = true;
                    return; // 용량 초과 파일은 추가하지 않고 건너뜀
                }

                // 2. 형식 체크
                if (file.type.match('image.*') || file.type === 'application/pdf') {
                    newFilesQueue.push(file); 
                } else {
                    hasTypeError = true;
                }
            });

            // 3. 에러 알림 (용량 에러가 형식 에러보다 우선순위가 높도록 배치)
            if (hasSizeError) {
                Swal.fire({ 
                    icon: 'warning', 
                    title: '용량 초과', 
                    text: `${MAX_FILE_MB}MB를 초과하는 파일은 첨부할 수 없습니다.`,
                    confirmButtonColor: '#d33' 
                });
            } else if (hasTypeError) {
                Swal.fire({ 
                    icon: 'error', 
                    title: '지원하지 않는 형식', 
                    text: '이미지(jpg, png 등) 또는 PDF 파일만 등록 가능합니다.', 
                    confirmButtonColor: '#d33' 
                });
            }

            renderNewFiles(); 
            input.value = ''; // 같은 파일을 다시 선택할 수 있도록 초기화
        } 
    };
    
    function renderNewFiles() { 
        const div = document.getElementById('new-file-list'); 
        div.innerHTML = ''; 
        newFilesQueue.forEach((f, idx) => { 
            const itemDiv = document.createElement('div');
            itemDiv.className = 'file-item';
            const nameSpan = document.createElement('span');
            nameSpan.textContent = `[추가] ${f.name}`; 
            const delBtn = document.createElement('button');
            delBtn.className = 'file-del-btn';
            delBtn.textContent = '삭제';
            delBtn.onclick = function() { removeNewFile(idx); }; 
            itemDiv.appendChild(nameSpan);
            itemDiv.appendChild(document.createTextNode(' ')); 
            itemDiv.appendChild(delBtn);
            div.appendChild(itemDiv);
        });
    }
    window.removeNewFile = function(idx) { newFilesQueue.splice(idx, 1); renderNewFiles(); };
    
    window.removeExistingFile = function(id, btn) { 
        Swal.fire({ title: '파일 삭제', text: "정말 삭제하시겠습니까? (서버에서도 영구 삭제됩니다)", icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33', cancelButtonColor: '#3085d6', confirmButtonText: '네, 삭제합니다', cancelButtonText: '취소' }).then((result) => {
            if (result.isConfirmed) {
                callApi('/api/file/delete', { fileId: id }).then(res => { 
                    existingFiles = existingFiles.filter(fid => fid !== id); 
                    btn.parentElement.remove(); 
                    Swal.fire('삭제 완료', res.msg, 'success'); 
                });
            }
        });
    };
    
    window.handleNumInput = function(el) { let val = el.value.replace(/[^0-9]/g, ''); if(!val) { el.value = ''; window.calculateRow(el); return; } el.value = formatNum(val); window.calculateRow(el); };
    window.calculateRow = function(el) { const r=el.closest('tr'); const u = unformatNum(r.querySelector('.p-unit').value); const q = unformatNum(r.querySelector('.p-qty').value); const total = u * q; r.querySelector('.p-total').value = (total === 0 && (u===0 || q===0)) ? "" : formatNum(total); window.updateGrandTotal(); };
    window.updateGrandTotal = function() { const rows = document.getElementsByClassName('item-row'); let grandTotal = 0; for(let i=0; i<rows.length; i++) { const rowTotal = unformatNum(rows[i].querySelector('.p-total').value); grandTotal += rowTotal; } document.getElementById('grandTotal').value = grandTotal > 0 ? formatNum(grandTotal) : ""; };

    async function renderAttachmentsForPrint(attachmentIds) {
        const printContainer = document.getElementById('print-image-container');
        printContainer.innerHTML = ""; 
        printContainer.className = "";
        let hasVisibleAttachment = false;

        if (!attachmentIds) return;
        // [B-5b] G 모드면 '첨부파일', E 모드면 '증빙자료'
        const printLabel = window.docType === 'G' ? '첨부파일' : '증빙자료';
        const files = attachmentIds.split(',');
        
        for (let i = 0; i < files.length; i++) {
            const trimId = files[i].trim(); 
            if(!trimId) continue;
            
            const lower = trimId.toLowerCase();
            // [보안] 인쇄 라벨에 서버 디렉토리 경로가 노출되지 않도록 파일명만 추출.
            //        화면의 첨부 링크는 이미 파일명만 표시(initViewMode) — 인쇄도 동일하게 맞춤.
            const displayName = trimId.split('/').pop();
            const box = document.createElement('div');
            box.className = 'print-att-box';
            let contentCreated = false;

            if (/\.(jpg|jpeg|png|gif|bmp|webp)$/i.test(lower)) {
                // [수정] 이미지 로딩 완료를 await 하여 인쇄 시점에 빈 영역으로 인쇄되는 문제 방지.
                //        innerHTML 로 <img> 만 삽입하면 src 다운로드가 비동기로 진행되어
                //        renderAttachmentsForPrint 가 먼저 끝나고 window.print() 가 호출되면서
                //        아직 로드되지 않은 이미지가 빈칸으로 인쇄되는 케이스가 발생했음.
                const label = document.createElement('span');
                label.className = 'print-att-label';
                label.innerText = `[별첨 ${i+1}] ${printLabel}: ${displayName}`;
                box.appendChild(label);

                const img = document.createElement('img');
                img.className = 'print-att-img';
                img.loading = 'eager';
                await new Promise((resolve) => {
                    img.onload  = () => resolve();
                    img.onerror = () => {
                        console.warn(`[Print] 이미지 로드 실패: ${trimId}`);
                        resolve(); // 실패해도 인쇄 진행은 계속
                    };
                    img.src = `/api/download/${trimId}`;
                });
                box.appendChild(img);
                contentCreated = true;
            } 
            else if (/\.pdf$/i.test(lower)) {
                try {
                    const loadingTask = pdfjsLib.getDocument(`/api/download/${trimId}`);
                    const pdf = await loadingTask.promise;
                    const numPages = pdf.numPages;

                    // PDF 의 각 페이지를 별도 .print-att-box (= A4 한 장) 로 렌더링.
                    // 첫 페이지는 메인 루프가 미리 만든 box 를 그대로 사용하고,
                    // 2페이지 이후는 새 box 를 만든다.
                    // 순서 보장을 위해 모든 페이지를 루프 안에서 직접 append 하고,
                    // 메인 루프 끝의 if(contentCreated) box append 는 우회한다.
                    for (let pageNum = 1; pageNum <= numPages; pageNum++) {
                        const pageBox = (pageNum === 1)
                            ? box
                            : Object.assign(document.createElement('div'), { className: 'print-att-box' });

                        const labelText = (numPages > 1)
                            ? `[별첨 ${i+1}] ${printLabel}: ${displayName} (${pageNum} / ${numPages})`
                            : `[별첨 ${i+1}] ${printLabel}: ${displayName}`;
                        pageBox.innerHTML = `<span class="print-att-label">${labelText}</span>`;

                        const page = await pdf.getPage(pageNum);
                        const viewport = page.getViewport({ scale: 2 });
                        const canvas = document.createElement('canvas');
                        canvas.height = viewport.height;
                        canvas.width  = viewport.width;
                        await page.render({
                            canvasContext: canvas.getContext('2d'),
                            viewport
                        }).promise;

                        const img = document.createElement('img');
                        img.className = 'print-att-img';
                        img.src = canvas.toDataURL('image/jpeg', 0.8);
                        pageBox.appendChild(img);

                        // 모든 페이지를 즉시 컨테이너에 append → 1, 2, 3, ..., N 순서 보장
                        printContainer.appendChild(pageBox);
                    }
                    // 메인 루프의 if(contentCreated) printContainer.appendChild(box) 를 거치면
                    // 첫 페이지(box) 가 다시 마지막으로 옮겨가 순서가 깨진다. 그래서 false 로 두고
                    // hasVisibleAttachment 만 직접 표시.
                    contentCreated = false;
                    hasVisibleAttachment = true;
                } catch (e) {
                    console.error("PDF Render Error", e);
                    box.innerHTML = `<span class="print-att-label">[별첨 ${i+1}] ${printLabel}: ${displayName}</span>` +
                                    `<div style="color:red; margin-top:20px;">PDF 변환 오류</div>`;
                    contentCreated = true;  // 에러 케이스는 box(=첫 페이지)를 메인 코드가 추가하도록 유지
                }
            }
            if (contentCreated) { printContainer.appendChild(box); hasVisibleAttachment = true; }
        }
        if (hasVisibleAttachment) printContainer.classList.add('visible');
    }

    // [수정] initViewMode: innerHTML 구조 업데이트 (3열 배치 대응)
