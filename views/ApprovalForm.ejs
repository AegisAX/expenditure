    if(d.payDate) document.getElementById('payDate').value = d.payDate;
      
    const snap = d.snapshotData || {};
    document.getElementById('u-info-line').innerText = `${d.applicantPos || ''} : ${d.applicantName || ''} (${snap.appPhone || d.applicantPhone || '-'})`;

	  // [수정] 기안자 직책 표시 보완 (누가 기안했는지 명시)
