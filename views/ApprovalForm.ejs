    document.getElementById('subject').value = d.subject || "";
    // [에디터] 본문 분기:
    //   WRITE 모드 → Toast UI Editor 마운트하며 초기값 주입
    //   VIEW  모드 → 읽기 전용 view div에 sanitize 된 HTML 렌더 (legacy plain text 호환)
    {
