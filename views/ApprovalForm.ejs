    window.printDoc = async function() {
        // [에디터] 인쇄용 본문 div에 HTML 렌더 (legacy plain text 호환).
        //          서버에서 sanitize 된 HTML이므로 innerHTML 사용이 안전하다.
        const bodySrc = (bodyEditor ? bodyEditor.getHTML() : (initData.bodyContent || document.getElementById('bodyContent').value || ''));
        renderBodyToView(bodySrc, document.getElementById('print-body-content-view'));
        document.querySelectorAll('.item-table textarea').forEach(el => {
             el.style.height = 'auto';
             el.style.height = (el.scrollHeight) + 'px';
        });

        const docNum = document.getElementById('docNum').value || "문서번호없음";
        const applicant = initData.applicantName || "기안자";
        // [B-5b] G 모드: 파일명 접두어 + 날짜는 executionDate(결재완료일) 사용
        let dateStr = '';
        if (window.docType === 'G') {
            dateStr = document.getElementById('execDate').value || new Date().toISOString().slice(0,10);
        } else {
            dateStr = document.getElementById('payDate').value || new Date().toISOString().slice(0,10);
        }
        const cleanDate = dateStr.replace(/-/g, '');
        const docTypeLabel = window.docType === 'G' ? '일반기안문' : '지출결의서';
        const newTitle = `${docTypeLabel}_${docNum}_${applicant}_${cleanDate}`;
        const originalTitle = document.title;
        document.title = newTitle;

        // [개선] 첨부파일이 있으면 인쇄 직전에 렌더링.
        //        결재 화면 단순 열람 시에는 호출되지 않으므로 다운로드 발생/로그 없음.
        //
        // [Swal 제거] window.print() 가 동기 블로킹 호출이라 Swal.close() 의 fade-out
        //             애니메이션 완료 전에 인쇄 다이얼로그가 떠서 Swal 잔상이 남는 문제 발생.
        //             전용 오버레이를 사용하여 try/finally 로 확실히 정리한다.
        const printContainer = document.getElementById('print-image-container');
        const overlay = document.getElementById('print-preparing-overlay');
        if (initData.attachmentIds && (!printContainer || !printContainer.classList.contains('visible'))) {
            if (overlay) overlay.style.display = 'flex';
            try {
                await renderAttachmentsForPrint(initData.attachmentIds);
            } catch (e) {
                console.error('인쇄 첨부 렌더링 실패:', e);
            } finally {
                if (overlay) overlay.style.display = 'none';
            }
        }

        // [감사로그] 인쇄 다이얼로그 열림 / 닫힘 액션 기록.
        //  - PRINT_DONE 은 사용자의 "저장/인쇄/취소" 를 구분하지 못하고
        //    다이얼로그가 닫힌 시점에 동일하게 발생함 (브라우저 한계).
        try {
            const csrf = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
            const docNumForLog = document.getElementById('trackingDocNum').value;
            if (docNumForLog) {
                fetch('/api/log/print-open', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrf },
                    body: JSON.stringify({ docNum: docNumForLog })
                }).catch(() => {});
                // 인쇄 다이얼로그 닫힘 1회만 잡도록 once: true
                window.addEventListener('afterprint', () => {
                    fetch('/api/log/print-close', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrf },
                        body: JSON.stringify({ docNum: docNumForLog })
                    }).catch(() => {});
                }, { once: true });
            }
        } catch (e) { /* 로그 실패는 인쇄 동작에 영향 없음 */ }

        // 브라우저가 오버레이 숨김을 화면에 반영할 시간 확보 후 인쇄 호출
        await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));

        window.print();
        setTimeout(() => { document.title = originalTitle; }, 1000);
    };
	
	  // [수정] 파일 미리보기 (PDF를 이미지로 변환하여 표시)
    window.openPreview = async function(url, fileName) {
        const modal = document.getElementById('previewModal');
        const container = document.getElementById('previewContainer');
        const title = document.getElementById('previewTitle');
        const dlBtn = document.getElementById('downloadBtn');
        const msg = document.getElementById('previewMsg');

        // [감사로그] 첨부파일 미리보기 액션 기록 (fire-and-forget)
        try {
            const docNum = document.getElementById('trackingDocNum').value;
            if (docNum) {
                const fileId = url.replace(/^\/api\/download\//, '');
                fetch('/api/log/preview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content') },
                    body: JSON.stringify({ docNum, fileId })
                }).catch(() => {});
            }
        } catch (e) { /* 로그 실패는 미리보기 동작에 영향 없음 */ }

        // 1. 초기화
        container.innerHTML = ""; // 기존 내용 비우기
        msg.style.display = 'block'; // 로딩 표시
        title.innerText = fileName || "파일 미리보기";
        // [수정] 실제 다운로드 버튼에만 ?download=1 부여하여 다운로드 감사 로그 기록 대상으로 표시.
        //        미리보기용 <img>/PDF.js 호출은 파라미터 없이 그대로 두어 로그에서 제외한다.
        dlBtn.href = url + (url.includes('?') ? '&' : '?') + 'download=1';
        modal.style.display = 'flex';

        const lower = url.toLowerCase();
        
        try {
            // 2. 이미지 파일인 경우
            if (/\.(jpg|jpeg|png|gif|webp)$/i.test(lower)) {
                const img = document.createElement('img');
                // [수정] max-height 제거 — flex-start 정렬 + 컨테이너 스크롤로 잘림 방지.
                //        height 는 자연 비율, max-width 100% 로 가로 폭만 제한.
                img.style.maxWidth = '100%';
                img.style.height = 'auto';
                img.style.display = 'block';
                // [수정] onerror 핸들러 추가. 이미지 로드 실패 시 아무 피드백 없이 "로딩 중" 에
                //        멈춰버리는 문제를 방지하고, 다운로드 버튼으로 유도한다.
                //        (handlers 를 src 보다 먼저 등록해 캐시된 즉시 로드도 놓치지 않음)
                img.onload  = () => { msg.style.display = 'none'; };
                img.onerror = () => {
                    msg.style.display = 'none';
                    container.innerHTML =
                        "<div style='text-align:center;padding:20px;color:#c0392b;'>" +
                        "이미지를 불러오지 못했습니다.<br>아래 [원본 다운로드] 버튼을 이용해 주세요.</div>";
                };
                img.src = url;
                container.appendChild(img);
            }
            // 3. PDF 파일인 경우 (pdf.js로 렌더링) — 모든 페이지를 위→아래 세로로 표시
            else if (/\.pdf$/i.test(lower)) {
                const loadingTask = pdfjsLib.getDocument(url);
                const pdf = await loadingTask.promise;
                const numPages = pdf.numPages;

                // 컨테이너 폭에 맞춰 스케일을 1번 페이지 기준으로 한 번만 계산.
                //   - PDF 가 컨테이너보다 크면 축소(최소 0.5)
                //   - PDF 가 컨테이너보다 작으면 최대 2.0 까지 확대
                //   - container.clientWidth 가 아직 0 인 초기 시점 대비 fallback
                const firstPage   = await pdf.getPage(1);
                let containerWidth = container.clientWidth - 20;
                if (!Number.isFinite(containerWidth) || containerWidth < 100) {
                    // modal 이 막 display:flex 로 전환되어 측정 전인 경우 등 fallback
                    containerWidth = 600;
                }
                const baseViewport = firstPage.getViewport({ scale: 1 });
                const scale = Math.min(2.0, Math.max(0.5, containerWidth / baseViewport.width));

                msg.style.display = 'none';   // 첫 페이지부터 점진적으로 표시

                for (let pageNum = 1; pageNum <= numPages; pageNum++) {
                    const page = pageNum === 1 ? firstPage : await pdf.getPage(pageNum);
                    const viewport = page.getViewport({ scale });

                    // 페이지 구분 라벨 (한 페이지짜리는 라벨 생략)
                    if (numPages > 1) {
                        const label = document.createElement('div');
                        label.style.cssText =
                            'width:100%;text-align:center;padding:6px 0;color:#888;font-size:12px;' +
                            (pageNum > 1 ? 'border-top:1px dashed #ddd;margin-top:8px;' : '');
                        label.textContent = `— ${pageNum} / ${numPages} —`;
                        container.appendChild(label);
                    }

                    const canvas = document.createElement('canvas');
                    canvas.height = viewport.height;
                    canvas.width  = viewport.width;
                    // CSS 로 너비 100% 제한 — 컨테이너보다 크면 자동 축소(가로 스크롤 없음)
                    canvas.style.maxWidth = '100%';
                    canvas.style.height = 'auto';
                    canvas.style.display = 'block';
                    canvas.style.marginBottom = '8px';
                    container.appendChild(canvas);

                    await page.render({
                        canvasContext: canvas.getContext('2d'),
                        viewport: viewport
                    }).promise;
                }
            }
            // 4. 그 외 파일 (다운로드 유도)
            else {
                msg.style.display = 'none';
                container.innerHTML = "<div style='text-align:center; padding:20px;'>미리보기를 지원하지 않는 형식입니다.<br>아래 버튼을 눌러 다운로드하세요.</div>";
            }
        } catch (e) {
            console.error(e);
            msg.style.display = 'none';
            container.innerHTML = "<div style='color:red;'>파일을 불러오는 중 오류가 발생했습니다.</div>";
        }
    };

    // [수정] 미리보기 닫기 (메모리 해제 등)
    window.closePreview = function() {
        const modal = document.getElementById('previewModal');
        modal.style.display = 'none';
        document.getElementById('previewContainer').innerHTML = ""; // 내용 비움
    };
  </script>
</body>
</html>