<script>
function escapeHtml(text) {
    if (!text) return "";
    return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
}

function getCsrfToken() { return document.querySelector('meta[name="csrf-token"]').getAttribute('content'); }

let currentDocPage = 1;
let docKeyword = "";
let currentLogPage = 1;
let logKeyword = "";

window.onload = function() {
    restoreSectionState();   // [개선] 직전 세션의 섹션 열림 상태 복원
    loadSettings();
    loadUsers();
    loadDocs(1); 
    loadAuditLogs(1);
    initGenOptions();
};

const SECTION_STATE_KEY = 'admin_open_sections';

function toggleSection(element) {
    // 섹션 내부의 버튼/입력창 클릭은 아코디언 동작 방지
    if (event.target.tagName === 'INPUT' || event.target.tagName === 'BUTTON' || event.target.tagName === 'SELECT' || event.target.closest('.section-content')) {
        return;
    }

    const isOpen = !element.classList.contains('collapsed');

    if (isOpen) {
        // 열려 있는 섹션을 클릭 → 닫기
        element.classList.add('collapsed');
    } else {
        // 닫혀 있는 섹션을 클릭 → 다른 섹션 모두 닫고 이 섹션만 열기 (한 번에 하나만 열림 유지)
        document.querySelectorAll('.section').forEach(sec => sec.classList.add('collapsed'));
        element.classList.remove('collapsed');
    }

    saveSectionState();
}

// 현재 열려 있는 섹션 ID 들을 sessionStorage 에 저장
function saveSectionState() {
    const openIds = [];
    document.querySelectorAll('.section').forEach(sec => {
        if (!sec.classList.contains('collapsed')) {
            const id = sec.dataset.sectionId;
            if (id) openIds.push(id);
        }
    });
    try {
        sessionStorage.setItem(SECTION_STATE_KEY, JSON.stringify(openIds));
    } catch (e) { /* 사용자가 sessionStorage 비활성화한 경우 무시 */ }
}

// 페이지 로드 시 sessionStorage 에 저장된 상태 복원
function restoreSectionState() {
    try {
        const raw = sessionStorage.getItem(SECTION_STATE_KEY);
        if (!raw) return; // 첫 진입: 모두 닫힌 상태 유지
        const openIds = JSON.parse(raw);
        if (!Array.isArray(openIds)) return;
        document.querySelectorAll('.section').forEach(sec => {
            const id = sec.dataset.sectionId;
            if (id && openIds.includes(id)) {
                sec.classList.remove('collapsed');
            } else {
                sec.classList.add('collapsed');
            }
    });
    } catch (e) { /* 파싱 실패 시 무시 */ }
}

function loadAuditLogs(page) {
    currentLogPage = page || 1;
    fetch(`/api/admin/logs?page=${currentLogPage}&keyword=${encodeURIComponent(logKeyword)}`)
    .then(r => r.json())
    .then(res => {
        const logs = res.logs || [];
        const tbody = document.getElementById('log-table-body');

        if (logs.length === 0) { 
            tbody.innerHTML = "<tr><td colspan='5' style='padding:20px; color:#999; text-align:center;'>기록된 로그가 없습니다.</td></tr>"; 
            document.getElementById('log-pagination').innerHTML = "";
            return; 
        }

        tbody.innerHTML = logs.map(l => {
            const dateObj = new Date(l.created_at.replace(' ', 'T') + 'Z');
            const dateStr = dateObj.toLocaleString('ko-KR', { month: 'numeric', day: 'numeric', hour: '2-digit', minute:'2-digit' });
            const ip = l.ip_address.replace('::ffff:', '');
            return `<tr>
                <td><strong>${escapeHtml(l.user_name)}</strong><br><small style="color:#888;">${escapeHtml(l.user_email)}</small></td>
                <td style="font-size:11px; color:#666;">${dateStr}</td>
                <td style="font-size:11px; color:#888;">${ip}</td>
                <td><span class="status-badge st-log">${l.action}</span></td>
                <td style="text-align:left; line-height:1.4; font-size:12px;">${escapeHtml(l.details)}</td>
            </tr>`;
        }).join('');

        renderPagination('log-pagination', res.page, res.totalPages, loadAuditLogs);
    }).catch(err => console.error("Logs load error:", err));
}

function searchLogs() {
    logKeyword = document.getElementById('log-keyword').value;
    loadAuditLogs(1);
}

function loadDocs(page) {
    currentDocPage = page || 1;
    fetch(`/api/admin/list?page=${currentDocPage}&keyword=${encodeURIComponent(docKeyword)}`)
    .then(r => r.json())
    .then(res => {
        const docs = res.docs || [];
        const tbody = document.getElementById('doc-list-body');

        if (docs.length === 0) { 
            tbody.innerHTML = "<tr><td colspan='5' style='padding:20px; color:#999; text-align:center;'>문서가 없습니다.</td></tr>"; 
            document.getElementById('doc-pagination').innerHTML = "";
            return; 
        }

        tbody.innerHTML = docs.map(d => {
            let badgeClass = 'st-temp';
            if(d.stage === '제출완료') badgeClass = 'st-req';
            else if(d.stage === '결재중') badgeClass = 'st-ing';
            else if(d.stage === '최종결재') badgeClass = 'st-done';
            else if(d.stage === '지급완료') badgeClass = 'st-paid';
            else if(d.stage === '결재완료') badgeClass = 'st-final-g'; /* [B-4b] 일반 기안 종결 */
            else if(d.stage === '반려') badgeClass = 'st-reject';

            let prefix = ''; let serial = d.docNum;
            if (d.docNum.includes('-')) {
                const parts = d.docNum.split('-');
                serial = parts.pop(); prefix = parts.join('-') + '-';
            }
            if (d.docNum.startsWith('TEMP-')) { prefix = ''; serial = ''; }

            /* [B-4b] 문서 유형 배지: G='기안' / E='지출' */
            const docType = d.docType === 'G' ? 'G' : 'E';
            const docTypeLabel = docType === 'G' ? '기안' : '지출';

            return `<tr onclick="openDocModal('${d.docNum}')" style="cursor:pointer;">
                <td><span class="doc-prefix">${prefix}</span><span class="doc-serial">${serial}</span></td>
                <td style="text-align:left;"><span class="doc-type-badge doc-type-${docType}">${docTypeLabel}</span>${escapeHtml(d.subject)}</td>
                <td>${escapeHtml(d.applicant)}</td>
                <td><span class="badge ${badgeClass}">${d.stage}</span></td>
                <td class="action-cell"><button class="action-btn btn-delete" onclick="event.stopPropagation(); deleteDoc('${d.docNum}')">삭제</button></td>
            </tr>`;
        }).join('');

        renderPagination('doc-pagination', res.page, res.totalPages, loadDocs);
    });
}

function searchDocs() {
    docKeyword = document.getElementById('doc-keyword').value;
    loadDocs(1);
}

function renderPagination(containerId, currentPage, totalPages, callback) {
    const container = document.getElementById(containerId);
    container.innerHTML = "";
    if (totalPages <= 1) return;

    if (currentPage > 1) {
        const prev = document.createElement('button');
        prev.innerText = "<"; prev.className = "page-btn"; prev.onclick = () => callback(currentPage - 1);
        container.appendChild(prev);
    }

    let start = Math.max(1, currentPage - 2);
    let end = Math.min(totalPages, start + 4);
    if (end - start < 4) start = Math.max(1, end - 4);

    for (let i = start; i <= end; i++) {
        const btn = document.createElement('button');
        btn.innerText = i;
        btn.className = `page-btn ${i === currentPage ? 'active' : ''}`;
        btn.onclick = () => callback(i);
        container.appendChild(btn);
    }

    if (currentPage < totalPages) {
        const next = document.createElement('button');
        next.innerText = ">"; next.className = "page-btn"; next.onclick = () => callback(currentPage + 1);
        container.appendChild(next);
    }
}

function initGenOptions() {
    const select = document.getElementById('edit-gen'); select.innerHTML = "";
    const currentYear = new Date().getFullYear();
    const currentTerm = Math.floor((currentYear - 1988) / 2) + 1;
    for (let i = 1; i <= currentTerm + 5; i++) {
        const option = document.createElement('option'); option.value = i; option.text = `제${i}대`; select.appendChild(option);
    }
}

function autoHyphen(target) {
    let val = target.value.replace(/[^0-9]/g, '');
    if (val.length > 11) val = val.substr(0, 11);
    let tmp = '';
    if (val.length < 4) tmp = val;
    else if (val.length < 7) tmp = val.substr(0, 3) + '-' + val.substr(3);
    else if (val.length < 11) tmp = val.substr(0, 3) + '-' + val.substr(3, 3) + '-' + val.substr(6);
    else tmp = val.substr(0, 3) + '-' + val.substr(3, 4) + '-' + val.substr(7);
    target.value = tmp;
}

function loadSettings() {
    fetch('/api/admin/settings').then(r=>r.json()).then(d=>{
        if(d.address)  document.getElementById('setting-address').value  = d.address;
        if(d.site_url) document.getElementById('setting-siteUrl').value  = d.site_url;

        // [A-4] 메일 설정 필드 로딩. smtp_pass는 서버에서 '********' 로 마스킹되어 옴.
        document.getElementById('setting-smtp-host').value      = d.smtp_host      || '';
        document.getElementById('setting-smtp-port').value      = d.smtp_port      || '';
        document.getElementById('setting-smtp-user').value      = d.smtp_user      || '';
        document.getElementById('setting-smtp-pass').value      = d.smtp_pass      || '';
        document.getElementById('setting-mail-from-name').value = d.mail_from_name || '';
    });
}

function saveSettings() {
    const payload = {
        address:        document.getElementById('setting-address').value,
        site_url:       document.getElementById('setting-siteUrl').value,
        // [A-4] 메일 설정 함께 저장.
        smtp_host:      document.getElementById('setting-smtp-host').value,
        smtp_port:      document.getElementById('setting-smtp-port').value,
        smtp_user:      document.getElementById('setting-smtp-user').value,
        // smtp_pass가 '********' 인 경우 서버에서 변경 없음으로 처리됨.
        smtp_pass:      document.getElementById('setting-smtp-pass').value,
        mail_from_name: document.getElementById('setting-mail-from-name').value
    };
    fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': getCsrfToken() },
        body: JSON.stringify(payload)
    })
    .then(r => r.json())
    .then(r => {
        Swal.fire('알림', r.msg, r.status === 'Success' ? 'success' : 'error');
        if (r.status === 'Success') {
            // 저장 성공 후 서버가 비밀번호를 마스킹한 값으로 갱신 → 다시 불러와 화면에 반영.
            loadSettings();
        }
    })
    .catch(err => Swal.fire('오류', err.message, 'error'));
}

// [A-4] 테스트 메일 발송 (관리자 본인 수신).
// 현재 DB에 저장된 SMTP 설정 기준으로 실제 발송한다.
// 저장 전 값이 화면에만 있는 상태라면, 먼저 "설정 저장" 을 누르도록 안내한다.
function sendTestMail() {
    const btn = document.getElementById('btn-test-mail');
    const originalText = btn.innerText;
    btn.disabled = true;
    btn.innerText = '발송 요청 중...';

    fetch('/api/admin/settings/test-mail', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': getCsrfToken() }
    })
    .then(r => r.json())
    .then(r => {
        Swal.fire(
            r.status === 'Success' ? '요청 완료' : '오류',
            r.msg || '처리 결과를 받지 못했습니다.',
            r.status === 'Success' ? 'success' : 'error'
        );
    })
    .catch(err => Swal.fire('오류', err.message, 'error'))
    .finally(() => {
        btn.disabled = false;
        btn.innerText = originalText;
    });
}

function loadUsers() {
    fetch('/api/admin/users').then(r => r.json()).then(users => {
        allUsers = users;
        const tbody = document.getElementById('userTableBody');
        tbody.innerHTML = users.map(u => {
            const isLocked = u.locked_until && new Date(u.locked_until) > new Date();
            let bCls = isLocked ? 'st-reject' : (u.status === 'Pending' ? 'st-pending' : 'st-approved');
            let bTxt = isLocked ? '잠김' : (u.status === 'Pending' ? '대기' : '승인');
            // 배지 클릭은 기존 동작(즉시 승인/잠금해제) 유지하기 위해 별도 onclick 부여
            const badgeClick = isLocked
                ? `event.stopPropagation(); unlockUser(${u.id}, '${escapeHtml(u.name)}', this)`
                : (u.status === 'Pending' ? `event.stopPropagation(); quickApproveUser(${u.id}, '${escapeHtml(u.name)}', this)` : '');

            // [수정] 행 전체 클릭 시 수정 모달 (배지 영역 클릭은 stopPropagation 으로 방지)
            return `<tr onclick="openModal(${u.id})" style="cursor:pointer;">
                <td style="font-weight:bold;">
                    <span class="pos-label">${escapeHtml(u.position)}</span>
                    <span class="name-text">${escapeHtml(u.name)}</span>
                </td>
                <td class="col-email">${escapeHtml(u.email)}</td>
                <td class="col-gen">${u.generation ? '제'+u.generation+'대' : '-'}</td>
                <td class="col-pos">${escapeHtml(u.position)}</td>
                <td><span class="status-badge ${bCls}" ${badgeClick ? `onclick="${badgeClick}"` : ''} style="cursor:${badgeClick?'pointer':'default'}">${bTxt}</span></td>
                <td class="col-role">${u.role}</td>
            </tr>`;
        }).join('');
    });
}

function quickApproveUser(id, name) {
    Swal.fire({ title: '가입 승인', text: `'${name}' 님의 가입을 승인하시겠습니까?`, icon: 'question', showCancelButton: true, confirmButtonColor: '#27ae60', confirmButtonText: '승인하기' }).then((r) => {
        if (r.isConfirmed) {
            fetch('/api/admin/user/approve', { method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': getCsrfToken() }, body: JSON.stringify({ id }) })
            .then(r => r.json()).then(res => { Swal.fire('완료', res.msg, 'success'); loadUsers(); });
        }
    });
}

function unlockUser(id, name) {
    Swal.fire({ title: '잠금 해제', text: `'${name}' 님의 계정 잠금을 해제하시겠습니까?`, icon: 'question', showCancelButton: true, confirmButtonColor: '#8e44ad', confirmButtonText: '해제하기' }).then((r) => {
        if (r.isConfirmed) {
            fetch('/api/admin/user/unlock', { method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': getCsrfToken() }, body: JSON.stringify({ id }) })
            .then(r => r.json()).then(res => { Swal.fire('완료', res.msg, 'success'); loadUsers(); });
        }
    });
}

function deleteUser(id, name) {
    Swal.fire({ title: '사용자 삭제', text: `'${name}' 님의 계정을 삭제하시겠습니까? (복구 불가)`, icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33' }).then((r) => {
        if (r.isConfirmed) {
            fetch('/api/admin/user/delete', { method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': getCsrfToken() }, body: JSON.stringify({ id }) })
            .then(r => r.json()).then(res => { Swal.fire('삭제됨', res.msg, 'success'); loadUsers(); });
        }
    });
}

let allUsers = [];

   // 가입 화면과 동일한 직책 옵션 목록 (미리 정의된 직책)
const PRESET_POSITIONS = [
    '총동문회장', '수석부회장', '사무총장', '기획국장', '총무국장',
    '재무국장', '편집국장', '문화국장', '멘토링위원장', '일반회원'
];

function openModal(id) {
    const u = allUsers.find(x => x.id === id);
    if(!u) return;
    document.getElementById('edit-id').value = u.id;
    document.getElementById('edit-email').value = u.email;
    document.getElementById('edit-name').value = u.name;
    document.getElementById('edit-phone').value = u.phone || "";
    document.getElementById('edit-gen').value = u.generation || "";
    document.getElementById('edit-status').value = u.status;
    document.getElementById('edit-role').value = u.role;

    // 직책: 프리셋에 있으면 select 로, 없으면 직접입력 모드로
    const posSelect = document.getElementById('edit-pos-select');
    const posInput = document.getElementById('edit-pos-input');
    if (PRESET_POSITIONS.includes(u.position)) {
        posSelect.value = u.position;
        posInput.classList.add('hidden');
        posInput.value = '';
    } else {
        posSelect.value = 'DIRECT';
        posInput.classList.remove('hidden');
        posInput.value = u.position || '';
    }

    // [개선] 본인 자신은 삭제 못 함 — 모달의 삭제 버튼 숨김
    const deleteBtn = document.getElementById('modal-delete-btn');
    if (deleteBtn) { deleteBtn.style.visibility = (u.email === '<%= user.email %>') ? 'hidden' : 'visible'; }
    document.getElementById('editModal').style.display = 'flex';
}

// 가입 화면의 toggleDirectInput 와 동일 로직
function toggleEditPosInput(el) {
    const input = document.getElementById('edit-pos-input');
    if (el.value === 'DIRECT') {
        input.classList.remove('hidden');
        input.focus();
    } else {
        input.classList.add('hidden');
        input.value = '';
    }
}

function closeModal() { document.getElementById('editModal').style.display = 'none'; }

function submitEdit() {
    const id = document.getElementById('edit-id').value;
    const email = document.getElementById('edit-email').value.trim();
    const name = document.getElementById('edit-name').value;
    const phone = document.getElementById('edit-phone').value;
    const gen = document.getElementById('edit-gen').value;
    const status = document.getElementById('edit-status').value;
    const role = document.getElementById('edit-role').value;
    const pw = document.getElementById('edit-pw').value;
    const f = document.getElementById('edit-sig');

    // 직책: select 또는 직접입력
    const posSelect = document.getElementById('edit-pos-select');
    let pos = posSelect.value;
    if (!pos) return Swal.fire('알림', '직책을 선택해주세요.', 'warning');
    if (pos === 'DIRECT') {
        pos = document.getElementById('edit-pos-input').value.trim();
        if (!pos) return Swal.fire('알림', '직책을 입력해주세요.', 'warning');
    }

    if(!email) return Swal.fire('알림', '이메일은 필수입니다.', 'warning');
    if(!name) return Swal.fire('알림', '이름은 필수입니다.', 'warning');

    const p = { id, email, name, position: pos, phone, generation: gen, status, role, newPassword: pw };
    if (f.files.length > 0) {
        const r = new FileReader();
        r.onload = ev => { p.signatureFile = { data: ev.target.result.split(',')[1], type: f.files[0].type }; sendEditRequest(p); }; r.readAsDataURL(f.files[0]);
    } else sendEditRequest(p);
}
    
function sendEditRequest(p) {
    fetch('/api/admin/user/update', { method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': getCsrfToken() }, body: JSON.stringify(p) })
    .then(r => r.json()).then(res => {
        if(res.status === 'Success') Swal.fire('완료', res.msg, 'success').then(() => { closeModal(); loadUsers(); }); else Swal.fire('오류', res.msg, 'error');
    });
}

function deleteDoc(docNum) {
    Swal.fire({ title: '영구 삭제?', text: "되돌릴 수 없으며 첨부파일도 삭제됩니다.", icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33' }).then((r) => {
        if (r.isConfirmed) {
            fetch('/api/admin/delete_doc', { method: 'POST', headers: { 'Content-Type': 'application/json', 'CSRF-Token': getCsrfToken() }, body: JSON.stringify({ docNum }) })
            .then(r => r.json()).then(res => { Swal.fire('삭제됨', res.msg, 'success'); loadDocs(currentDocPage); });
        }
    });
}

// [개선] 모달 안에서 삭제 버튼 클릭. 확인 후 삭제 → 모달 닫고 목록 갱신
function deleteUserFromModal() {
    const id = document.getElementById('edit-id').value;
    const name = document.getElementById('edit-name').value;
    if (!id) return;
    Swal.fire({
        title: '사용자 삭제',
        text: `'${name}' 님의 계정을 삭제하시겠습니까? (복구 불가)`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: '삭제',
        cancelButtonText: '취소'
    }).then((r) => {
        if (r.isConfirmed) {
            fetch('/api/admin/user/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'CSRF-Token': getCsrfToken() },
                body: JSON.stringify({ id })
            })
            .then(r => r.json()).then(res => {
                Swal.fire('삭제됨', res.msg, 'success');
                closeModal();
                loadUsers();
            });
        }
    });
}

let currentDocModalNum = null;

function openDocModal(docNum) {
    currentDocModalNum = docNum;
    document.getElementById('docModal').style.display = 'flex';

    fetch(`/api/admin/doc/${encodeURIComponent(docNum)}`)
    .then(r => r.json())
    .then(res => {
        if (res.status !== 'Success') {
            Swal.fire('오류', res.msg || '문서 조회 실패', 'error');
            closeDocModal();
            return;
        }
        const doc = res.doc;
        const docType = doc.docType === 'G' ? 'G' : 'E';
        const docTypeLabel = docType === 'G' ? '일반 기안' : '지출결의서';

        document.getElementById('docm-num').textContent = doc.docNum;
        document.getElementById('docm-type').innerHTML =
            `<span class="doc-type-badge doc-type-${docType}">${docType === 'G' ? '기안' : '지출'}</span> ${docTypeLabel}`;
        document.getElementById('docm-subject').textContent = doc.subject || '(제목 없음)';

        let badgeClass = 'st-temp';
        if (doc.status === '제출완료')      badgeClass = 'st-req';
        else if (doc.status === '결재중')   badgeClass = 'st-ing';
        else if (doc.status === '최종결재') badgeClass = 'st-done';
        else if (doc.status === '지급완료') badgeClass = 'st-paid';
        else if (doc.status === '결재완료') badgeClass = 'st-final-g';
        else if (doc.status === '반려')     badgeClass = 'st-reject';
        document.getElementById('docm-status').innerHTML =
            `<span class="badge ${badgeClass}">${doc.status}</span>`;

        document.getElementById('docm-applicant').textContent =
            `${doc.appName || '-'} (${doc.appPos || '-'})`;
        document.getElementById('docm-reqdate').textContent = doc.reqDate || '-';

        // 금액은 지출결의서('E') 전용 — 일반 기안('G')에서는 행 자체를 숨김
        const amountDt = document.getElementById('docm-amount-dt');
        const amountDd = document.getElementById('docm-amount');
        if (docType === 'G') {
            amountDt.style.display = 'none';
            amountDd.style.display = 'none';
        } else {
            amountDt.style.display = '';
            amountDd.style.display = '';
            amountDd.textContent = doc.totalAmount
                ? Number(doc.totalAmount).toLocaleString('ko-KR') + '원'
                : '-';
        }

        // 건너뛰기 이력 — dt/dd 두 요소를 함께 토글
        const skipDt = document.getElementById('docm-skip-dt');
        const skipInfo = document.getElementById('docm-skip-info');
        if (doc.secSkippedBy) {
            const dt = doc.secSkippedAt
                ? new Date(doc.secSkippedAt).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' })
                : '-';
            skipInfo.innerHTML =
                `<strong>${escapeHtml(doc.secSkippedBy)}</strong><br>` +
                `<span style="color:#7f8c8d; font-size:11px;">${dt}</span><br>` +
                `사유: ${escapeHtml(doc.secSkippedReason || '-')}`;
            skipDt.style.display = '';
            skipInfo.style.display = '';
        } else {
            skipDt.style.display = 'none';
            skipInfo.style.display = 'none';
        }

        const skipBtn = document.getElementById('docm-skip-btn');
        const skipGuide = document.getElementById('docm-skip-guide');
        if (res.canSkipSecretary) {
            skipBtn.style.display = '';
            skipGuide.style.display = '';
        } else {
            skipBtn.style.display = 'none';
            skipGuide.style.display = 'none';
        }
    })
    .catch(err => {
        console.error(err);
        Swal.fire('오류', '문서 조회 중 통신 오류가 발생했습니다.', 'error');
        closeDocModal();
    });
}

function closeDocModal() {
    document.getElementById('docModal').style.display = 'none';
    currentDocModalNum = null;
}

function deleteDocFromModal() {
    if (!currentDocModalNum) return;
    const docNum = currentDocModalNum;
    Swal.fire({
        title: '영구 삭제?',
        text: "되돌릴 수 없으며 첨부파일도 삭제됩니다.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: '삭제',
        cancelButtonText: '취소'
    }).then((r) => {
        if (r.isConfirmed) {
            fetch('/api/admin/delete_doc', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'CSRF-Token': getCsrfToken() },
                body: JSON.stringify({ docNum })
            })
            .then(r => r.json())
            .then(res => {
                Swal.fire('삭제됨', res.msg, 'success');
                closeDocModal();
                loadDocs(currentDocPage);
            });
        }
    });
}

function confirmSkipStage() {
    if (!currentDocModalNum) return;
    const docNum = currentDocModalNum;

    Swal.fire({
        title: '사무총장 단계 건너뛰기',
        html:
            '<div style="text-align:left; font-size:13px; color:#555; margin-bottom:10px;">' +
            '문서를 사무총장 결재 없이 총동문회장 결재 단계로 넘깁니다.<br>' +
            '사유는 감사 로그에 기록되며 총동문회장에게 메일로 전달됩니다.' +
            '</div>',
        input: 'textarea',
        inputLabel: '건너뛰기 사유 (필수)',
        inputPlaceholder: '예: 사무총장 해외 출장 중',
        inputAttributes: { 'maxlength': 500, 'aria-label': '건너뛰기 사유' },
        showCancelButton: true,
        confirmButtonColor: '#BA7517',
        confirmButtonText: '건너뛰기 실행',
        cancelButtonText: '취소',
        inputValidator: (value) => {
            if (!value || !value.trim()) return '사유는 필수 입력입니다.';
            if (value.length > 500)      return '사유는 500자 이내로 입력해 주세요.';
        }
    }).then((result) => {
        if (!result.isConfirmed) return;
        const reason = result.value.trim();

        Swal.fire({ title: '처리 중...', didOpen: () => Swal.showLoading() });

        fetch('/api/admin/skip-stage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'CSRF-Token': getCsrfToken() },
            body: JSON.stringify({ docNum, reason })
        })
        .then(r => r.json())
        .then(res => {
            if (res.status === 'Success') {
                Swal.fire('완료', res.msg, 'success');
                closeDocModal();
                loadDocs(currentDocPage);
            } else {
                Swal.fire('오류', res.msg || '처리 실패', 'error');
            }
        })
        .catch(err => {
            console.error(err);
            Swal.fire('오류', '서버와 통신 중 오류가 발생했습니다.', 'error');
        });
    });
}
</script>
